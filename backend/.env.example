# Copy to backend/.env. All values are backend-only.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./canopy-dev.db
# Supabase: direct connection or session pooler (port 5432), not transaction pooling.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:5432/postgres
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
# Create this at https://aistudio.google.com/api-keys. Never use NEXT_PUBLIC_ for it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_INPUT_CHARACTERS=12000
