# Copy to backend/.env. All values are backend-only.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./canopy-dev.db
# Supabase: direct connection or session pooler (port 5432), not transaction pooling.
# DATABASE_URL=postgresql+psycopg://RUNTIME_USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=/run/canopy/supabase-ca.crt
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
# Create this at https://aistudio.google.com/api-keys. Never use NEXT_PUBLIC_ for it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_INPUT_CHARACTERS=12000
# Frozen embedding model: gemini-embedding-001, 768 normalized dimensions.
# Free-tier inputs may be used for product improvement. Enable customer query search only
# with provider terms suitable for that data (normally a paid-services project).
# Public/synthetic policy-index, embedding-smoke, and policy-evaluate work without this flag.
POLICY_SEARCH_ENABLED=false
# Enable only with provider data terms suitable for customer messages and order context.
WORKFLOW_ENABLED=false
# Enable after approving provider processing of live microphone audio. Use HTTPS or localhost.
VOICE_ENABLED=false
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_CALLS_PER_DAY=100
VOICE_MAX_CALL_SECONDS=300
# Manual metadata-only LangSmith export; automatic graph tracing is explicitly disabled.
WORKFLOW_TRACING_ENABLED=false
LANGSMITH_API_KEY=
# Generate a random secret (at least 32 characters) and share it across backend replicas.
ADMISSION_KEY=
LOGIN_ATTEMPTS_PER_ACCOUNT_MINUTE=10
LOGIN_ATTEMPTS_PER_IP_MINUTE=40
LOGIN_ATTEMPTS_TOTAL_MINUTE=300
REFRESH_ATTEMPTS_PER_IP_MINUTE=90
REFRESH_ATTEMPTS_TOTAL_MINUTE=900
CUSTOMER_TURNS_PER_MINUTE=15
PROVIDER_CALLS_PER_ACCOUNT_MINUTE=16
# Hard counts of provider attempts per UTC day. Set a budget to 0 to pause that operation.
GEMINI_CHAT_CALLS_PER_DAY=500
GEMINI_EMBEDDING_CALLS_PER_DAY=250
